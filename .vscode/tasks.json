
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LanzarBrowserSync",
            "type": "shell",
            "command": "browser-sync.cmd start --server src -f \"**/*\" ./src/ --no-open",
            "presentation": {"reveal": "silent"},
            "isBackground": true,
            "problemMatcher": []
        },
         {
            "label": "debugBrowserSync",
            "type": "shell",
            "command": "browser-sync.cmd start --server ./ -f \"**/*\" ./ --no-open",
            "presentation": {"reveal": "silent"},
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "PararBrowserSync",
            "type": "shell",
            "command": "echo ${input:terminate}",
            "problemMatcher":[]
        }
    ],
    "inputs": [
        {
            "id": "terminate",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "terminateAll"
        }
    ]
}
