{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LanzarBrowserSync",
            "type": "shell",
            "command": "browser-sync.cmd start --server src --no-open --no-snippet --no-notify --no-ghost-mode --no-reload-on-restart",
            "presentation": {
                "reveal": "silent"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "debugBrowserSync",
            "type": "shell",
            "command": "browser-sync.cmd start --server src --serveStatic ./ --port 3000 --no-open --no-snippet --no-notify --no-ghost-mode --no-reload-on-restart",
            "presentation": {
                "reveal": "silent"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "PararBrowserSync",
            "type": "shell",
            "command": "echo ${input:terminate}",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "terminate",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "terminateAll"
        }
    ]
}
